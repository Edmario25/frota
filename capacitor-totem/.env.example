# ─────────────────────────────────────────────────────────────────────────────
# Copie este arquivo para .env e preencha antes de rodar `npm run build`
# ─────────────────────────────────────────────────────────────────────────────

# Credenciais da conta de serviço do totem
# (crie o usuário no Supabase → Authentication → Users → Invite user)
VITE_TOTEM_EMAIL=totem@apicegestao.com
VITE_TOTEM_SENHA=352811623

# ID da obra fixada no totem (opcional)
# Deixe em branco para registrar sem obra (null)
# Cole o UUID da obra: Supabase → Table Editor → obras → coluna id
VITE_OBRA_ID=
