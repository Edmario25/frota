# URL e chave pública. Nunca use service_role no APK.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Credenciais individuais retornadas por criar_ponto_totem().
VITE_TOTEM_DEVICE_ID=
VITE_TOTEM_DEVICE_SECRET=
VITE_APP_VERSION=1.1.0
