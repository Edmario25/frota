# ─────────────────────────────────────────────────────────────────────────────
# Copie este arquivo para .env e preencha antes de rodar `npm run build`
# ─────────────────────────────────────────────────────────────────────────────

# Chave pública opcional. Nunca use service_role no APK.
VITE_SUPABASE_PUBLISHABLE_KEY=

# ID obrigatório da obra fixada no totem
# Cole o UUID da obra: Supabase → Table Editor → obras → coluna id
VITE_OBRA_ID=
